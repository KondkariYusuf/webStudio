DIRECT_URL=postgresql://postgres:yusuf@localhost:5432/webstudio

AUTH_SECRET=devsecret123
# GH_CLIENT_SECRET=
# GH_CLIENT_ID=
DEV_LOGIN=true

# Restrictions
MAX_ASSETS_PER_PROJECT=50

POSTGREST_URL=http://localhost:3000
# JWT token, decode using jwt.io. Encoded with PGRST_JWT_SECRET from docker-compose.yml
POSTGREST_API_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6IndlYnN0dWRpbyIsImlhdCI6MTc3NTQ3MDAyMSwiZXhwIjoyMDkwODMwMDIxfQ.vRgTJcJs1qj_CZdasLZRaO7sr29ETDmzpuHa8wVFCNs"

# Optional max upload size in Mb
# MAX_UPLOAD_SIZE=10

# S3 envs
# S3_BUCKET=
# S3_REGION=
# S3_ACL="public-read"
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# if using S3/R2 this is your worker URL
# ASSET_CDN_URL=http://localhost:3000/assets

# Publisher config
# PUBLISHER_HOST=wstd.local
# PUBLISHER_ENDPOINT=http://localhost:3000/publisher
# PUBLISHER_TOKEN=

# Username and password displayed in wstd domain settings
# STAGING_USERNAME=admin
# STAGING_PASSWORD=webstudio

# Base origin for accessing user-generated build (canvas / preview / etc)
# Should contain protocol and host (e.g. [https://example.com](https://example.com))
# Will be detected automatically in development environments like localhost or preview deployment
# BUILD_ORIGIN=[https://wstd.live](https://wstd.live)

# If set to `true`, user-generated build will be available
# only at {project.domain} subdomain of {BUILD_ORIGIN}.
# This is used in production deployment for security reasons.
# BUILD_REQUIRE_SUBDOMAIN=

# Enable features behind a flag, * enables all.
FEATURES=*
# Current user plan features (default)
USER_PLAN=pro

# TRCP server url and API token. If empty local TRPC server is used
# TRPC_SERVER_URL=
# TRPC_SERVER_API_TOKEN=

# AI Features
# OPENAI_KEY=
# OPENAI_ORG=

PRISMA_TELEMETRY_OPT_OUT=1
REMIX_TELEMETRY_OPT_OUT=1