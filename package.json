{
  "name": "webstudio-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "Backend/packages/*",
    "Frontend/apps/*",
    "Frontend/fixtures/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present --include-workspace-root=false",
    "dts": "npm run dts --workspaces --if-present --include-workspace-root=false",
    "dev": "concurrently \"npm run dev:postgrest\" \"npm run dev:builder\" -n pg,builder -c magenta,blue",
    "dev:builder": "npm run dev -w @webstudio-is/builder",
    "dev:postgrest": "dotenv -e .env -- postgrest.exe postgrest.conf",
    "lint": "eslint \"**/*.{ts,tsx}\" --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "postgrest:roles": "npm run build -w @webstudio-is/postgrest && node --env-file=.env ./Backend/packages/postgrest/dist/index.server.js",
    "migrations": "npm run generate -w @webstudio-is/prisma-client && npm run migrations -w @webstudio-is/prisma-client -- migrate --dev --cwd ../../../ && npm run postgrest:roles",
    "build-figma-tokens": "npm run build-figma-tokens -w @webstudio-is/design-system",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "patch-package": "^8.0.0"
  },
  "overrides": {
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.25",
    "react": "18.3.0-canary-14898b6a9-20240318",
    "react-dom": "18.3.0-canary-14898b6a9-20240318"
  },
  "devDependencies": {
    "@prisma/client": "^5.12.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.12.1",
    "tsx": "^4.21.0"
  }
}
